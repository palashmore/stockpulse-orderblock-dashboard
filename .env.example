# Copy this file to `.env` (which git ignores) and fill in your own values.
# Never commit .env or paste these values into chat, issues or screenshots.

# ICICI Direct Breeze API (free for ICICI Direct customers; register an app at
# https://api.icicidirect.com/apiuser/home with redirect URL https://127.0.0.1)
BREEZE_API_KEY=
BREEZE_API_SECRET=

# Optional: phone/desktop push for price alerts
# 1. ntfy (free, open source; https://ntfy.sh)
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# 2. Telegram Bot API
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 3. Discord Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 4. Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_TO_NUMBER=
# TWILIO_FROM_NUMBER=

# 5. Generic Custom Webhook
# GENERIC_WEBHOOK_URL=https://example.com/webhook

# Optional
# STATIC_DIR=dist                 # folder with the built app; the server serves it when it exists
# ALERTS_FILE=data/alerts.json
# PORT=3001
# CORS_ORIGIN=https://your-frontend.example   # only when the app is hosted on a different address from the server (comma-separated list)
# RATE_LIMIT_PER_MIN=120          # other devices on your network
# RATE_LIMIT_LOCAL_PER_MIN=1200   # this computer (screens that scan hundreds of stocks need a high limit)
# UPSTREAM_CONCURRENCY=4   # requests in flight to each data provider at once
