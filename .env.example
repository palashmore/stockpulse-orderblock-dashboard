# Copy this file to `.env` (which git ignores) and fill in your own values.
# Never commit .env or paste these values into chat, issues or screenshots.

# ICICI Direct Breeze API (free for ICICI Direct customers; register an app at
# https://api.icicidirect.com/apiuser/home with redirect URL https://127.0.0.1)
BREEZE_API_KEY=
BREEZE_API_SECRET=

# Optional
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# RATE_LIMIT_PER_MIN=120
# UPSTREAM_CONCURRENCY=4
