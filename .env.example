# Copy this file to `.env` (which git ignores) and fill in your own values.
# Never commit .env or paste these values into chat, issues or screenshots.

# ICICI Direct Breeze API (free for ICICI Direct customers; register an app at
# https://api.icicidirect.com/apiuser/home with redirect URL https://127.0.0.1)
BREEZE_API_KEY=
BREEZE_API_SECRET=

# Optional: phone/desktop push for price alerts, through ntfy (free, open source; https://ntfy.sh).
# Install the ntfy app, subscribe to your topic, and put the same topic here. The alert text (symbol, level,
# price) is sent to that topic and anyone who knows the name can read it, so use a long random name.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Optional
# ALERTS_FILE=data/alerts.json
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# RATE_LIMIT_PER_MIN=120
# UPSTREAM_CONCURRENCY=4
